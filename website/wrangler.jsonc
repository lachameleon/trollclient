{
	// Troll Client homepage: static files from ./public, plus a small Worker for the live bits.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "troll-client",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// everything else is served as a plain file without waking the Worker up
		"run_worker_first": ["/api/*", "/downloads/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "HQ", "class_name": "TrollHQ" },
			// anonymous usage reports from the client, for /analytics
			{ "name": "TELEMETRY", "class_name": "TrollTelemetry" },
			// the chatroom every running client is in (.chat in game)
			{ "name": "CHAT", "class_name": "TrollChat" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TrollHQ"] },
		{ "tag": "v2", "new_sqlite_classes": ["TrollTelemetry"] },
		{ "tag": "v3", "new_sqlite_classes": ["TrollChat"] }
	],
	"vars": {
		// Who may moderate the forum and the chatroom and see raw telemetry sessions: Minecraft accounts, comma separated,
		// as UUIDs (best: they survive a name change) or names. Not a secret. An account proves itself in the chatroom the
		// same way it logs in to a server, then uses `.mod ...` in game. Empty = nobody moderates.
		// Don't know your UUID? Type `.mod` in game and it tells you.
		"MODERATORS": ""
	},
	"observability": { "enabled": true }
	// no secrets to set: the salt for visitor hashes and tripcodes is made up by the Worker on its first run and kept in its storage
}
