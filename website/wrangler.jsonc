{
	// Troll Client homepage: static files from ./public, plus a small Worker for the live bits.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "troll-client",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// everything else is served as a plain file without waking the Worker up
		"run_worker_first": ["/api/*", "/downloads/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "HQ", "class_name": "TrollHQ" },
			// anonymous usage reports from the client, for /analytics
			{ "name": "TELEMETRY", "class_name": "TrollTelemetry" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TrollHQ"] },
		{ "tag": "v2", "new_sqlite_classes": ["TrollTelemetry"] }
	],
	"observability": { "enabled": true }
	// optional secrets: `npx wrangler secret put ADMIN_TOKEN` (lets you hide guestbook entries and see raw telemetry sessions)
	// and `npx wrangler secret put SALT` (salts the daily visitor hashes)
}
